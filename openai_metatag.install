<?php

/**
 * @file
 * Install and update hooks for OpenAI Metatag Helper.
 */

/**
 * Implements hook_install().
 */
function openai_metatag_install() {
  // Enable auto-generate on save by default for fresh installs via config/install JSON.
  $config = config('openai_metatag.settings');

  // Initialize enabled_bundles to all current node types (enabled = 1) if not set.
  $enabled_bundles = $config->get('enabled_bundles');
  if (!is_array($enabled_bundles)) {
    $types = node_type_get_types();
    $enabled_bundles = array();
    foreach ($types as $type) {
      $enabled_bundles[$type->type] = 1;
    }
    $config->set('enabled_bundles', $enabled_bundles);
    $config->save();
  }
}

/**
 * Enable auto-generate on save and ensure all existing bundles are initialized.
 */
function openai_metatag_update_10001() {
  $config = config('openai_metatag.settings');

  // Only set auto_generate_on_save if it's not already set (preserve admin choice).
  $current_auto = $config->get('auto_generate_on_save');
  if (!isset($current_auto)) {
    $config->set('auto_generate_on_save', 1);
  }

  // Ensure enabled_bundles exists and includes all current types.
  $current = $config->get('enabled_bundles');
  if (!is_array($current)) {
    $current = array();
  }
  $types = node_type_get_types();
  foreach ($types as $type) {
    if (!array_key_exists($type->type, $current)) {
      $current[$type->type] = 1; // Enable new/missing bundles by default.
    }
  }
  $config->set('enabled_bundles', $current);
  $config->save();

  return t('OpenAI Metatag: Initialized enabled content types.');
}

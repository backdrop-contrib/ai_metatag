<?php

/**
 * @file
 * AI Metatag Assistant: Generate SEO metatags on node edit forms.
 */

/**
 * Implements hook_ai_tools().
 */
function ai_metatag_ai_tools() {
  if (!module_exists('ai_tools') || !module_exists('metatag')) {
    return [];
  }
  module_load_include('inc', 'ai_metatag', 'includes/metatag.tools');
  return ai_metatag_tools_definitions();
}

/**
 * Implements hook_config_info().
 */
function ai_metatag_config_info() {
  return [
    'ai_metatag.settings' => [
      'label' => t('AI Metatag settings'),
      'group' => t('AI'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function ai_metatag_menu() {
  $items = [];

  $items['admin/config/ai/ai-metatag'] = [
    'title' => 'AI Metatag Assistant',
    'description' => 'Configure AI Metatag Assistant per content type.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['ai_metatag_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];

  return $items;
}

/**
 * Settings form builder.
 */
function ai_metatag_settings_form($form, &$form_state) {
  $form = [];
  $form['#config'] = 'ai_metatag.settings';

  // List all node bundles.
  $types = node_type_get_types();
  $options = [];
  foreach ($types as $type) {
    $options[$type->type] = check_plain($type->name);
  }

  // Load and normalize enabled bundles from config.
  $enabled_bundles = config_get('ai_metatag.settings', 'enabled_bundles');
  if (is_array($enabled_bundles)) {
    $normalized = [];
    foreach ($enabled_bundles as $k => $v) {
      if (!empty($v)) {
        $normalized[$k] = 1;
      }
    }
    $enabled_bundles = $normalized;
  }
  else {
    // Default: enable for all bundles.
    $enabled_bundles = array_fill_keys(array_keys($options), 1);
  }

  // Build default checked values as an array of selected keys (FAPI expects
  // the option key as the value for checked items).
  $default_selected = [];
  foreach ($enabled_bundles as $bundle_key => $is_enabled) {
    if (!empty($is_enabled)) {
      $default_selected[$bundle_key] = $bundle_key;
    }
  }

  $form['enabled_bundles'] = [
    '#type' => 'checkboxes',
    '#title' => t('Enable on these content types'),
    '#options' => $options,
    '#default_value' => $default_selected,
    '#description' => t('The button appears in the Meta tags fieldset when editing these content types.'),
    '#element_validate' => ['ai_metatag_enabled_bundles_validate'],
  ];

  $form['auto_generate_on_save'] = [
    '#type' => 'checkbox',
    '#title' => t('Auto-generate meta tags on save'),
    '#default_value' => (int) (config_get('ai_metatag.settings', 'auto_generate_on_save') ?: 0),
    '#description' => t('When enabled, the module will generate missing tags on save for the selected content types. Existing values are never overwritten.'),
  ];

  $form['notes'] = [
    '#type' => 'markup',
    '#markup' => '<p>' . t('Note: Users must also have the permissions "Generate metatags with AI" and "Edit meta tags" (or "Administer meta tags"). The Metatag fieldset must be available on the content type.') . '</p>',
  ];

  // AI options: model + max tokens (module-level override; falls back to ai.settings).
  $opts = ai_metatag_get_options();
  $form['options'] = [
    '#type' => 'fieldset',
    '#title' => t('AI options'),
    '#tree' => TRUE,
  ];

  // Model selector: use ai module helper for all chat models from all providers.
  $model_options = ai_get_all_chat_models();

  // Determine default model.
  $default_model = config_get('ai.settings', 'default_text_model') ?: '';
  $flat_models = [];
  foreach ($model_options as $g_label => $g_items) {
    if (is_array($g_items)) {
      foreach ($g_items as $k => $v) { $flat_models[$k] = $v; }
    } else {
      $flat_models[$g_label] = $g_items;
    }
  }
  if (!empty($flat_models) && !isset($flat_models[$default_model])) {
    reset($flat_models);
    $default_model = key($flat_models);
  }

  $default_model = ai_metatag_default_ai_model($flat_models, $default_model);

  $form['options']['ai_model'] = [
    '#type' => 'select',
    '#title' => t('AI model'),
    '#options' => $model_options,
    '#default_value' => isset($opts['ai_model']) && $opts['ai_model'] !== '' ? $opts['ai_model'] : $default_model,
    '#description' => t('Select which text model to use when generating metatags.'),
  ];

  $form['options']['ai_max_tokens'] = [
    '#type' => 'number',
    '#title' => t('AI max tokens'),
    '#default_value' => isset($opts['ai_max_tokens']) ? (int) $opts['ai_max_tokens'] : 1000,
    '#min' => 64,
    '#max' => 2048,
    '#description' => t('Maximum number of tokens the AI may return (min 64, max 2048).'),
  ];

  // Pre-submit: sanitize values before system_settings_form saves them.
  $form['#submit'][] = 'ai_metatag_settings_form_submit';

  return system_settings_form($form);
}

/**
 * Element validator: normalize enabled_bundles checkbox values to 1/0.
 */
function ai_metatag_enabled_bundles_validate(&$element, &$form_state, $form) {
  if (isset($form_state['values']['enabled_bundles']) && is_array($form_state['values']['enabled_bundles'])) {
    $normalized = [];
    foreach ($form_state['values']['enabled_bundles'] as $bundle => $value) {
      $normalized[$bundle] = !empty($value) ? 1 : 0;
    }
    $form_state['values']['enabled_bundles'] = $normalized;
  }
}

function ai_metatag_settings_form_submit($form, &$form_state) {
  // Normalize checkbox values to 1/0 so config exports are clean.
  if (isset($form_state['values']['enabled_bundles']) && is_array($form_state['values']['enabled_bundles'])) {
    $normalized = [];
    foreach ($form_state['values']['enabled_bundles'] as $bundle => $value) {
      $normalized[$bundle] = !empty($value) ? 1 : 0;
    }
    $form_state['values']['enabled_bundles'] = $normalized;
  }
  // Also normalize the boolean checkbox.
  $form_state['values']['auto_generate_on_save'] = !empty($form_state['values']['auto_generate_on_save']) ? 1 : 0;

  // Normalize options tree (ai_model, ai_max_tokens).
  if (!isset($form_state['values']['options']) || !is_array($form_state['values']['options'])) {
    $form_state['values']['options'] = [];
  }
  $opts =& $form_state['values']['options'];
  $default_model = ai_metatag_default_ai_model();
  $opts += [
    'ai_model' => $default_model,
    'ai_max_tokens' => 256,
  ];
  $opts['ai_model'] = is_string($opts['ai_model']) && trim($opts['ai_model']) !== '' ? trim($opts['ai_model']) : $default_model;
  $opts['ai_max_tokens'] = (int) $opts['ai_max_tokens'];
  if ($opts['ai_max_tokens'] < 64) { $opts['ai_max_tokens'] = 64; }
  if ($opts['ai_max_tokens'] > 2048) { $opts['ai_max_tokens'] = 2048; }

  // Clean up legacy root-level option keys. The active config should use the
  // nested "options" structure exclusively.
  $settings = config('ai_metatag.settings');
  $settings->clear('ai_model');
  $settings->clear('ai_max_tokens');
  $settings->save();

  backdrop_set_message(t('AI Metatag Assistant settings saved.'));
}

/**
 * Return normalized module options with legacy fallback support.
 */
function ai_metatag_get_options() {
  $settings = config('ai_metatag.settings');
  $options = $settings->get('options');
  $options = is_array($options) ? $options : [];

  if (empty($options['ai_model'])) {
    $legacy_model = $settings->get('ai_model');
    if (is_string($legacy_model) && trim($legacy_model) !== '') {
      $options['ai_model'] = trim($legacy_model);
    }
  }

  if (!isset($options['ai_max_tokens']) || !is_numeric($options['ai_max_tokens'])) {
    $legacy_max_tokens = $settings->get('ai_max_tokens');
    if (is_numeric($legacy_max_tokens)) {
      $options['ai_max_tokens'] = (int) $legacy_max_tokens;
    }
  }

  return $options;
}

/**
 * Determine the default AI model, preferring configured and available models.
 */
function ai_metatag_default_ai_model(array $flat_models = [], $fallback = '') {
  if (empty($flat_models) && function_exists('ai_get_all_chat_models')) {
    $flat_models = ai_flatten_models(ai_get_all_chat_models());
  }

  $configured_default = config_get('ai.settings', 'default_text_model');
  if (is_string($configured_default) && $configured_default !== '') {
    if (empty($flat_models) || isset($flat_models[$configured_default])) {
      return $configured_default;
    }
  }

  return _ai_metatag_model_from_flat($flat_models, $fallback);
}

/**
 * Picks a default from an already-flat models array.
 */
function _ai_metatag_model_from_flat(array $flat_models, $preferred) {
  if (empty($flat_models)) {
    return $preferred;
  }
  if (isset($flat_models[$preferred])) {
    return $preferred;
  }
  reset($flat_models);
  return key($flat_models);
}

/**
 * Implements hook_permission().
 */
function ai_metatag_permission() {
  return [
    'generate metatags with ai' => [
      'title' => t('Generate metatags with AI'),
      'description' => t('Allows users to click a button on content forms to auto-fill Metatag fields using AI.'),
    ],
  ];
}

/**
 * Ensure our form_alter runs after Metatag builds its form.
 */
function ai_metatag_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'form_alter' && isset($implementations['ai_metatag'])) {
    // Move this module to the end so metatag_form_alter runs first.
    $weight = $implementations['ai_metatag'];
    unset($implementations['ai_metatag']);
    $implementations['ai_metatag'] = $weight;
  }
}

/**
 * Helper to detect if we are on a node edit/create form.
 */
function _ai_metatag_is_node_form($form_id, $form) {
  // Common Backdrop/Drupal patterns:
  // - '<bundle>_node_form' (e.g., 'post_node_form')
  // - 'node_form' (base form ID)
  // - Sometimes #entity_type === 'node'
  if (is_string($form_id)) {
    if ($form_id === 'node_form' || substr($form_id, -10) === '_node_form') {
      return TRUE;
    }
    if (strpos($form_id, 'node_') === 0 && !empty($form['#entity_type']) && $form['#entity_type'] === 'node') {
      return TRUE;
    }
  }
  if (!empty($form['#entity_type']) && $form['#entity_type'] === 'node') {
    return TRUE;
  }
  // Also match inline or programmatic node edit forms.
  if (!empty($form['#node_edit_form']) || (!empty($form['#entity']) && isset($form['#entity']->type))) {
    return TRUE;
  }
  return FALSE;
}

/**
 * Implements hook_form_alter().
 */
function ai_metatag_form_alter(&$form, &$form_state, $form_id) {
  // Only act on node edit/create forms.
  if (!_ai_metatag_is_node_form($form_id, $form)) {
    return;
  }

  if (!isset($form['ai_metatag_preview_text'])) {
    $form['ai_metatag_preview_text'] = [
      '#type' => 'hidden',
      '#default_value' => '',
    ];
    $form['#attached']['js'][] = backdrop_get_path('module', 'ai_metatag') . '/js/ai_metatag_preview_extract.js';
  }

  // Attach an after_build to ensure our button is injected even if Metatag
  // builds its elements later or other modules re-order things.
  if (empty($form['#after_build']) || !in_array('ai_metatag_after_build', $form['#after_build'])) {
    $form['#after_build'][] = 'ai_metatag_after_build';
  }

  // Respect per-bundle enable setting (default all on).
  $bundle = !empty($form['#bundle']) ? $form['#bundle'] : (!empty($form['#node_type']) ? $form['#node_type'] : (!empty($form['#entity']) && isset($form['#entity']->type) ? $form['#entity']->type : NULL));
  $enabled_bundles = config_get('ai_metatag.settings', 'enabled_bundles');
  if (is_array($enabled_bundles) && $bundle && empty($enabled_bundles[$bundle])) {
    watchdog('ai_metatag', 'Form alter: bundle @bundle disabled for AI Metatag.', ['@bundle' => $bundle], WATCHDOG_DEBUG);
    return;
  }

  // Metatag fieldset is added by Metatag module as $form['metatags'] with language child.
  if (empty($form['metatags']) || !is_array($form['metatags'])) {
    // Defer to after_build; optionally message once for privileged users.
    static $notified = FALSE;
    if (!$notified && user_access('generate metatags with ai')) {
      backdrop_set_message(t('AI Metatag: Metatag fields are not available on this form yet. If they do not appear, ensure the Metatag module is enabled for this content type and that you have permission to edit meta tags.'), 'warning');
      $notified = TRUE;
    }
    watchdog('ai_metatag', 'Form alter: metatags fieldset missing on initial alter for form_id @id.', ['@id' => $form_id], WATCHDOG_DEBUG);
    return;
  }

  // Permission check: user must be able to edit meta tags and generate via AI.
  if (!(user_access('edit meta tags') || user_access('administer meta tags'))) {
    watchdog('ai_metatag', 'Form alter: user lacks Metatag edit/admin permission.', [], WATCHDOG_DEBUG);
    return;
  }
  // Allow site administrators to see the button even if the explicit permission
  // was not granted yet (helps initial setup/debugging).
  if (!(user_access('generate metatags with ai') || user_access('administer site configuration'))) {
    watchdog('ai_metatag', 'Form alter: user lacks "generate metatags with ai" permission.', [], WATCHDOG_DEBUG);
    return;
  }

  // Determine langcode used by Metatag on this form.
  $langcode = LANGUAGE_NONE;
  if (!empty($form['metatags']['#language'])) {
    $langcode = $form['metatags']['#language'];
  }

  // Ensure the language container exists (Metatag builds metatags[$langcode]).
  if (empty($form['metatags'][$langcode]) || !is_array($form['metatags'][$langcode])) {
    watchdog('ai_metatag', 'Form alter: metatags language container missing (@lang).', ['@lang' => $langcode], WATCHDOG_DEBUG);
    return;
  }

  // Wrap the language container with an #ajax wrapper to update it after generation.
  $wrapper_id = 'ai-metatag-wrapper-' . $langcode;
  ai_metatag_apply_ajax_wrapper($form['metatags'][$langcode], $wrapper_id);

  // Add the Generate button near the top (just after intro text if present).
  if (!isset($form['metatags']['ai_generate'])) {
    $button = ai_metatag_build_generate_button($wrapper_id);
    // Place inside the metatags fieldset root, before fields.
    $form['metatags']['ai_generate'] = $button;
  }
}

/**
 * After build: ensure the Generate button is injected once Metatag elements exist.
 */
function ai_metatag_after_build($form, &$form_state) {
  // Only process node forms.
  $form_id = isset($form['#form_id']) ? $form['#form_id'] : '';
  if (!_ai_metatag_is_node_form($form_id, $form)) {
    return $form;
  }

  // Bundle enable check (default: enabled).
  $bundle = !empty($form['#bundle']) ? $form['#bundle'] : (!empty($form['#node_type']) ? $form['#node_type'] : (!empty($form['#entity']) && isset($form['#entity']->type) ? $form['#entity']->type : NULL));
  $enabled_bundles = config_get('ai_metatag.settings', 'enabled_bundles');
  if (is_array($enabled_bundles) && $bundle && empty($enabled_bundles[$bundle])) {
    return $form;
  }

  // Permissions.
  if (!(user_access('edit meta tags') || user_access('administer meta tags'))) {
    return $form;
  }
  // Allow site administrators to see the button even if the explicit permission
  // was not granted yet (helps initial setup/debugging).
  if (!(user_access('generate metatags with ai') || user_access('administer site configuration'))) {
    return $form;
  }

  if (empty($form['metatags']) || !is_array($form['metatags'])) {
    // Nothing to do if metatags fieldset truly absent.
    return $form;
  }

  // Determine langcode and ensure container exists.
  $langcode = !empty($form['metatags']['#language']) ? $form['metatags']['#language'] : LANGUAGE_NONE;
  if (empty($form['metatags'][$langcode]) || !is_array($form['metatags'][$langcode])) {
    return $form;
  }

  // Add wrapper if not present.
  $wrapper_id = 'ai-metatag-wrapper-' . $langcode;
  ai_metatag_apply_ajax_wrapper($form['metatags'][$langcode], $wrapper_id);


  // Inject the button if missing.
  if (!isset($form['metatags']['ai_generate'])) {
    $form['metatags']['ai_generate'] = ai_metatag_build_generate_button($wrapper_id);
  }

  return $form;
}

/**
 * AJAX callback: return the updated metatags language container.
 */
function ai_metatag_generate_ajax($form, &$form_state) {
  $langcode = !empty($form['metatags']['#language']) ? $form['metatags']['#language'] : LANGUAGE_NONE;
  return isset($form['metatags'][$langcode]) ? $form['metatags'][$langcode] : $form['metatags'];
}

/**
 * Generate SEO suggestions via AI for given title and body.
 *
 * @return array|null
 *   Array with keys: title, description, og_title, og_description, keywords; or NULL on failure.
 */
function ai_metatag_generate_suggestions($title, $body_text) {
  if (!module_exists('ai')) {
    return NULL;
  }

  // Trim and limit context length to avoid token overuse.
  $context_excerpt = AIContentExtractor::htmlToMarkdown($body_text);
  // Keep a larger context window for better title/description quality.
  if (backdrop_strlen($context_excerpt) > 6000) {
    $context_excerpt = backdrop_substr($context_excerpt, 0, 6000) . '…';
  }

  $prompt = "You are an SEO assistant for a CMS. Based on the provided content, suggest concise metadata.\n"
    . "Return ONLY valid JSON with keys: title, description, og_title, og_description, og_type, keywords (comma-separated).\n"
    . "og_type must be a valid Open Graph type (e.g. article, website, product, profile). Use 'article' for most content pages.\n"
    . "Constraints: title <= 60 chars, description 140-160 chars, no quotes in values.\n\n"
    . "=== CONTENT TITLE ===\n" . (string) $title . "\n"
    . "=== CONTENT EXCERPT ===\n" . (string) $context_excerpt . "\n"
    . "=== END OF CONTENT ===\n";

  // Prefer module-level options if configured, fall back to global ai.settings.
  $opts = ai_metatag_get_options();
  $model = !empty($opts['ai_model']) ? $opts['ai_model'] : ai_metatag_default_ai_model();
  $max_tokens = !empty($opts['ai_max_tokens']) ? (int) $opts['ai_max_tokens'] : 256;

  // Ensure an API provider is available for the selected model. This avoids
  // false failures when non-default providers (Ollama/OpenRouter/etc.) are used.
  $stripped_model = '';
  $api = ai_get_api_for_model($model, $stripped_model);
  if (!$api) {
    watchdog('ai_metatag', 'No provider configured for metatag model @model.', ['@model' => $model], WATCHDOG_ERROR);
    return NULL;
  }

  try {
    $messages = [
      ['role' => 'system', 'content' => 'You generate SEO metadata for web pages.'],
      ['role' => 'user', 'content' => $prompt],
    ];

    // Use the centralized helper function
    $result = ai_chat($model, $messages, 0.4, $max_tokens, FALSE, ['operation' => 'metatag']);

    // Extract text; support both Chat and Responses API shapes.
    $text = '';
    if (is_array($result)) {
      if (!empty($result['output_text'])) {
        $text = trim((string) $result['output_text']);
      }
      if (empty($text) && !empty($result['output']) && is_array($result['output'])) {
        foreach ($result['output'] as $outputItem) {
          if (!empty($outputItem['content']) && is_array($outputItem['content'])) {
            foreach ($outputItem['content'] as $contentPart) {
              if (isset($contentPart['text']) && is_string($contentPart['text'])) {
                $text .= $contentPart['text'];
              }
            }
          }
        }
      }
      $text = trim($text);
    }
    else {
      $text = (string) $result;
    }

    if (empty($text)) {
      return NULL;
    }

    // Strip code fences if any and decode JSON.
    $text = trim($text);
    if (strpos($text, '```') === 0) {
      $text = trim(preg_replace('/^```[a-zA-Z]*\n?|```$/', '', $text));
    }
    $decoded = json_decode($text, TRUE);
    if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
      // Normalize expected keys.
      $title_sugg = isset($decoded['title']) ? trim($decoded['title']) : '';
      $description_sugg = isset($decoded['description']) ? trim($decoded['description']) : '';
      $og_title_sugg = isset($decoded['og_title']) ? trim($decoded['og_title']) : $title_sugg;
      $og_description_sugg = isset($decoded['og_description']) ? trim($decoded['og_description']) : $description_sugg;

      // Ensure description/og_description fit within 140-160 chars for SEO checks.
      $description_sugg = ai_metatag_normalize_description($description_sugg, $title, $context_excerpt);
      // If OG description outside acceptable bounds, mirror normalized description.
      $og_len = mb_strlen(trim($og_description_sugg));
      if ($og_len < 140 || $og_len > 160) {
        $og_description_sugg = $description_sugg;
      }

      $valid_og_types = [
        'article', 'website', 'book', 'profile', 'music.song', 'music.album',
        'music.playlist', 'music.radio_station', 'video.movie', 'video.episode',
        'video.tv_show', 'video.other', 'product',
      ];
      $og_type_raw = isset($decoded['og_type']) ? strtolower(trim($decoded['og_type'])) : '';
      $og_type_sugg = in_array($og_type_raw, $valid_og_types, TRUE) ? $og_type_raw : 'article';

      return [
        'title' => $title_sugg,
        'description' => $description_sugg,
        'og_title' => $og_title_sugg,
        'og_description' => $og_description_sugg,
        'og_type' => $og_type_sugg,
        'keywords' => isset($decoded['keywords']) ? $decoded['keywords'] : '',
      ];
    }
  }
  catch (\Exception $e) {
    watchdog('ai_metatag', 'AI error: @m', ['@m' => $e->getMessage()], WATCHDOG_ERROR);
  }

  return NULL;
}

/**
 * Recursively collect human-readable text from form values arrays.
 *
 * Handles deeply nested structures such as Paragraphs, field collections, or
 * custom compound fields. Stops when the limit is reached.
 */
function ai_metatag_collect_text_from_values($values, $limit = 4000) {
  $chunks = [];
  AIContentExtractor::collectTextRecursive($values, $chunks, [
    'keep_numeric' => TRUE,
  ]);
  $out = trim(preg_replace('/\s+/', ' ', implode(' ', array_values(array_unique(array_filter(array_map('trim', $chunks)))))));
  if (backdrop_strlen($out) > $limit) {
    $out = backdrop_substr($out, 0, $limit) . '...';
  }
  return $out;
}

/**
 * Collect text from editable node field values only (cleaner than full form).
 */
function ai_metatag_collect_text_from_node_form_values($form, $form_state, $limit = 4000) {
  $values = !empty($form_state['values']) && is_array($form_state['values']) ? $form_state['values'] : [];
  if (empty($values)) {
    return '';
  }

  $node = !empty($form['#entity']) ? $form['#entity'] : (!empty($form['#node']) ? $form['#node'] : NULL);
  $bundle = !empty($node->type) ? $node->type : NULL;
  if (empty($bundle)) {
    return ai_metatag_collect_text_from_values($values, $limit);
  }

  $out = AIContentExtractor::extractNodeFormValuesText($values, $bundle, [
    'include_title' => TRUE,
    'keep_numeric' => TRUE,
    'max_length' => $limit,
  ]);
  return trim($out);
}

/**
 * Recursively collect human-readable text from an entity (node/paragraph).
 */
function ai_metatag_collect_text_from_entity($entity, $langcode = NULL, $limit = 4000) {
  if (empty($entity)) {
    return '';
  }

  $entity_type = 'node';
  if (method_exists($entity, 'entityType')) {
    $entity_type = $entity->entityType();
  }
  elseif (isset($entity->entity_type)) {
    $entity_type = $entity->entity_type;
  }
  elseif (isset($entity->tid)) {
    $entity_type = 'taxonomy_term';
  }
  $out = AIContentExtractor::extractEntityText($entity_type, $entity, [
    'view_mode' => 'full',
    'include_label' => TRUE,
    'max_length' => $limit,
  ]);
  return trim(preg_replace('/\s+/', ' ', $out));
}

/**
 * Recursively find a metatag element's 'value' sub-element by tag key.
 *
 * Returns a reference suitable for form_set_value(). If not found, returns a
 * NULL reference. This searches within grouped containers like 'basic',
 * 'advanced', 'open-graph', etc.
 *
 * @param array $container
 *   The metatags language container array, e.g. $form['metatags'][$lang].
 * @param string $tag_key
 *   The metatag machine name, e.g. 'title', 'description', 'og:title'.
 *
 * @return array|null
 *   Reference to the 'value' element array, or NULL if not found.
 */
function &ai_metatag_find_value_element_ref(&$container, $tag_key) {
  $null = NULL;
  if (!is_array($container)) {
    return $null;
  }
  // Direct child check first.
  if (isset($container[$tag_key]) && is_array($container[$tag_key]) && isset($container[$tag_key]['value'])) {
    return $container[$tag_key]['value'];
  }
  // Depth-first search through child arrays (skip properties starting with '#').
  foreach ($container as $k => &$v) {
    if (is_string($k) && $k !== '' && $k[0] === '#') {
      continue;
    }
    if (is_array($v)) {
      // If this child itself is the tag container.
      if ($k === $tag_key && isset($v['value'])) {
        return $v['value'];
      }
      $found = &ai_metatag_find_value_element_ref($v, $tag_key);
      if (isset($found)) {
        return $found;
      }
    }
  }
  return $null;
}

/**
 * Collect available metatag keys that have a 'value' input anywhere in container.
 */
function ai_metatag_collect_available_keys_recursive($container, &$out = []) {
  if (!is_array($container)) {
    return $out;
  }
  foreach ($container as $k => $v) {
    if (is_string($k) && $k !== '' && $k[0] === '#') {
      continue;
    }
    if (is_array($v)) {
      if (isset($v['value'])) {
        // $k here should be the metatag key like 'title' or 'og:title'.
        $out[$k] = TRUE;
      }
      // Recurse deeper (handles group containers like 'basic', 'advanced', 'open-graph').
      ai_metatag_collect_available_keys_recursive($v, $out);
    }
  }
  return $out;
}

/**
 * Submit handler: call AI and populate metatag fields in the form state.
 */
function ai_metatag_generate_submit($form, &$form_state) {
  // Prevent form submission; we only want to update form values.
  $form_state['rebuild'] = TRUE;

  // Collect context from the node form: title and body text.
  $node = !empty($form['#entity']) ? $form['#entity'] : (!empty($form['#node']) ? $form['#node'] : NULL);
  $title = '';
  if (!empty($form['#title'])) {
    $title = $form['#title'];
  }
  if (isset($form_state['values']['title'])) {
    $title = is_array($form_state['values']['title']) && isset($form_state['values']['title'][0]['value']) ? $form_state['values']['title'][0]['value'] : $form_state['values']['title'];
  }

  $body_text = '';
  // Prefer rendered preview text from the editor UI when available.
  if (!empty($form_state['values']['ai_metatag_preview_text']) && is_string($form_state['values']['ai_metatag_preview_text'])) {
    $body_text = trim($form_state['values']['ai_metatag_preview_text']);
  }
  // If preview extraction is missing or very short/noisy, fall back to
  // structured node field values and combine both when useful.
  if (!empty($form_state['values']) && is_array($form_state['values'])) {
    $fallback_text = ai_metatag_collect_text_from_node_form_values($form, $form_state, 8000);
    if (empty($body_text)) {
      $body_text = $fallback_text;
    }
    elseif (backdrop_strlen($body_text) < 600 && !empty($fallback_text)) {
      $body_text = trim($body_text . "\n\n" . $fallback_text);
    }
  }
  if (empty($body_text) && $node) {
    $lang_for_text = !empty($form['metatags']['#language']) ? $form['metatags']['#language'] : LANGUAGE_NONE;
    $body_text = ai_metatag_collect_text_from_entity($node, $lang_for_text, 8000);
  }

  $suggestions = ai_metatag_generate_suggestions($title, $body_text);
  if (empty($suggestions)) {
    backdrop_set_message(t('Could not generate suggestions from AI.'), 'error');
    return;
  }

  // Determine the correct metatags language container.
  $langcode = !empty($form['metatags']['#language']) ? $form['metatags']['#language'] : LANGUAGE_NONE;
  if (empty($form['metatags'][$langcode]) || !is_array($form['metatags'][$langcode])) {
    // Fall back to the first available container under metatags.
    foreach ($form['metatags'] as $k => $v) {
      if (is_string($k) && $k !== '' && $k[0] === '#') {
        continue;
      }
      if (is_array($v)) {
        $langcode = $k;
        break;
      }
    }
  }

  // Collect available keys for diagnostics (searching recursively under groups).
  $available_map = [];
  if (!empty($form['metatags'][$langcode]) && is_array($form['metatags'][$langcode])) {
    ai_metatag_collect_available_keys_recursive($form['metatags'][$langcode], $available_map);
  }
  $available = array_keys($available_map);

  // Helper to set a value if that element exists (recursively).
  $set_if_exists = function($key_path, $value) use (&$form, &$form_state, $langcode) {
    if (empty($form['metatags'][$langcode]) || !is_array($form['metatags'][$langcode])) {
      return FALSE;
    }
    $ref = &ai_metatag_find_value_element_ref($form['metatags'][$langcode], $key_path);
    if (isset($ref)) {
      if (!isset($form_state['input']) || !is_array($form_state['input'])) {
        $form_state['input'] = [];
      }
      if (!empty($ref['#parents']) && is_array($ref['#parents'])) {
        // form_set_value() requires #parents to be present on the element.
        form_set_value($ref, $value, $form_state);
        backdrop_array_set_nested_value($form_state['input'], $ref['#parents'], $value);
      }
      else {
        $form_state['input']['metatags'][$langcode][$key_path]['value'] = $value;
      }
      return TRUE;
    }
    return FALSE;
  };

  // Determine enabled text tags from Metatag settings and info.
  $enabled_text_tags = ai_metatag_get_enabled_text_tags();
  $filled = 0;
  foreach ($available as $tag_key) {
    if (!isset($enabled_text_tags[$tag_key])) {
      continue; // Not enabled globally.
    }
    $value = ai_metatag_pick_suggestion_value($tag_key, $suggestions);
    if ($value !== '') {
      $filled += $set_if_exists($tag_key, $value) ? 1 : 0;
    }
  }

  if ($filled > 0) {
    backdrop_set_message(t('SEO meta tags generated and populated. Review before saving.'));
  }
  else {
    // Provide richer diagnostics for admins and in logs.
    watchdog('ai_metatag', 'No matching metatag fields found. Lang "@lang"; available keys: @keys', ['@lang' => $langcode, '@keys' => implode(', ', $available)], WATCHDOG_WARNING);
    $lang_hint = ($langcode === LANGUAGE_NONE) ? ' ' . t('(Language module is disabled; using language "und".)') : '';
    if (user_access('administer site configuration')) {
      $details = empty($available) ? t('none') : check_plain(implode(', ', $available));
      backdrop_set_message(t('No matching metatag fields found to populate.@hint Available keys for this form: @keys', ['@keys' => $details, '@hint' => $lang_hint]), 'warning');
    }
    else {
      backdrop_set_message(t('No matching metatag fields found to populate.@hint', ['@hint' => $lang_hint]), 'warning');
    }
  }
}

/**
 * Build the shared Generate button definition.
 *
 * @param string $wrapper_id
 *   AJAX wrapper ID for metatags language container.
 *
 * @return array
 *   Button form element definition.
 */
function ai_metatag_build_generate_button($wrapper_id) {
  return [
    '#type' => 'submit',
    '#value' => t('Generate SEO with AI'),
    '#submit' => ['ai_metatag_generate_submit'],
    '#limit_validation_errors' => [],
    '#attributes' => [
      'class' => ['ai-metatag-generate-button'],
    ],
    '#ajax' => [
      'callback' => 'ai_metatag_generate_ajax',
      'wrapper' => $wrapper_id,
      'method' => 'replace',
      'effect' => 'fade',
    ],
    '#weight' => -9,
  ];
}

/**
 * Apply an AJAX wrapper to an element without clobbering existing wrappers.
 */
function ai_metatag_apply_ajax_wrapper(&$element, $wrapper_id) {
  $wrapper_marker = 'id="' . $wrapper_id . '"';
  $existing_prefix = isset($element['#prefix']) ? $element['#prefix'] : '';
  if (strpos($existing_prefix, $wrapper_marker) !== FALSE) {
    return;
  }

  $element['#prefix'] = $existing_prefix . '<div id="' . $wrapper_id . '">';
  $element['#suffix'] = '</div>' . (isset($element['#suffix']) ? $element['#suffix'] : '');
}


/**
 * Implements hook_node_presave().
 *
 * Auto-generate missing meta tags on save when enabled in settings.
 */
function ai_metatag_node_presave($node) {
  // Check global toggle.
  $auto = (int) (config_get('ai_metatag.settings', 'auto_generate_on_save') ?: 0);
  if (!$auto) {
    return;
  }

  // Respect per-bundle enable setting (default all on if config absent).
  $bundle = isset($node->type) ? $node->type : NULL;
  $types = node_type_get_types();
  $all_enabled_default = array_fill_keys(array_keys($types), 1);
  $enabled_bundles = config_get('ai_metatag.settings', 'enabled_bundles');
  if (!is_array($enabled_bundles)) {
    $enabled_bundles = $all_enabled_default;
  }
  if (empty($bundle) || empty($enabled_bundles[$bundle])) {
    return;
  }

  // Determine language for metatags.
  $langcode = LANGUAGE_NONE;
  if (function_exists('metatag_entity_get_language')) {
    $langcode = metatag_entity_get_language('node', $node);
  }
  if (empty($langcode)) {
    $langcode = LANGUAGE_NONE;
  }

  // Ensure container arrays exist.
  if (!isset($node->metatags) || !is_array($node->metatags)) {
    $node->metatags = [];
  }
  if (!isset($node->metatags[$langcode]) || !is_array($node->metatags[$langcode])) {
    $node->metatags[$langcode] = [];
  }

  // Helper to read current value.
  $get_val = function($tag) use ($node, $langcode) {
    return isset($node->metatags[$langcode][$tag]['value']) ? trim($node->metatags[$langcode][$tag]['value']) : '';
  };

  // Determine which text tags are reasonable to auto-fill for this entity.
  $enabled_text_tags = ai_metatag_get_presave_text_tags($node, 'node', $bundle, $langcode);
  $empties = [];
  foreach ($enabled_text_tags as $tag => $_) {
    if ($get_val($tag) === '') {
      $empties[$tag] = TRUE;
    }
  }

  watchdog('ai_metatag', 'Presave: bundle=@bundle lang=@lang empty tags: @tags', [
    '@bundle' => $bundle,
    '@lang' => $langcode,
    '@tags' => empty($empties) ? t('none') : implode(', ', array_keys($empties)),
  ], WATCHDOG_DEBUG);

  if (empty($empties)) {
    return; // Nothing to do.
  }

  // Build content context.
  $title_text = isset($node->title) ? $node->title : '';
  // For paragraphs-based sites, walk the entity structure for text content.
  $body_text = ai_metatag_collect_text_from_entity($node, $langcode, 4000);

  $suggestions = ai_metatag_generate_suggestions($title_text, $body_text);
  if (empty($suggestions)) {
    // Do not block save; just log.
    watchdog('ai_metatag', 'Auto-generate skipped: no suggestions produced.', [], WATCHDOG_WARNING);
    return;
  }

  // Helper to set if empty only.
  $set_if_empty = function($tag, $value) use (&$node, $langcode, $get_val) {
    if ($get_val($tag) === '' && $value !== '') {
      $node->metatags[$langcode][$tag]['value'] = $value;
      return TRUE;
    }
    return FALSE;
  };

  $changed = [];
  foreach (array_keys($empties) as $tag) {
    $value = ai_metatag_pick_suggestion_value($tag, $suggestions);
    if ($value !== '' && $set_if_empty($tag, $value)) {
      $changed[] = $tag;
    }
  }

  if (!empty($changed)) {
    watchdog('ai_metatag', 'Presave: populated tags (@tags).', ['@tags' => implode(', ', $changed)], WATCHDOG_INFO);
  }
}

/**
 * Determine which metatag keys are enabled and should be auto-filled.
 *
 * Uses Metatag's own info and settings to get only enabled tags, then filters
 * to text-like tags we can safely generate: title, description, abstract,
 * keywords, and their OG/Twitter variants (e.g., og:title, twitter:description).
 */
function ai_metatag_get_enabled_text_tags() {
  $enabled = [];
  if (!module_exists('metatag')) {
    return $enabled;
  }
  // Get only enabled tags (metatag_get_info() without include_disabled).
  $tags_info = metatag_get_info('tags');
  if (!is_array($tags_info)) {
    return $enabled;
  }
  foreach ($tags_info as $machine_name => $info) {
    // Heuristic: only consider text/list/title classes.
    $class = isset($info['class']) ? $info['class'] : '';
    $is_texty = in_array($class, ['BackdropTextMetaTag', 'BackdropTitleMetaTag', 'BackdropListMetaTag']);
    if (!$is_texty) {
      continue;
    }
    $name = strtolower($machine_name);
    // Allow these patterns.
    $allow = FALSE;
    if ($name === 'title' || substr($name, -6) === ':title') {
      $allow = TRUE;
    }
    elseif ($name === 'keywords') {
      $allow = TRUE;
    }
    elseif ($name === 'description' || $name === 'abstract' || substr($name, -12) === ':description') {
      $allow = TRUE;
    }
    elseif ($name === 'og:type') {
      $allow = TRUE;
    }
    // Exclude known non-textuals even if TextMetaTag (URLs, images, times).
    if (strpos($name, 'url') !== FALSE || strpos($name, 'image') !== FALSE || strpos($name, 'updated') !== FALSE || strpos($name, 'modified') !== FALSE || strpos($name, 'published') !== FALSE || $name === 'canonical') {
      $allow = FALSE;
    }
    if ($allow) {
      $enabled[$machine_name] = TRUE;
    }
  }
  return $enabled;
}

/**
 * Choose which suggestion value to use for a given tag key.
 */
function ai_metatag_pick_suggestion_value($tag_key, array $s) {
  $k = strtolower($tag_key);
  // Keywords explicitly.
  if ($k === 'keywords') {
    return isset($s['keywords']) ? $s['keywords'] : '';
  }
  // OG type.
  if ($k === 'og:type') {
    return isset($s['og_type']) ? $s['og_type'] : 'article';
  }
  // Title-like.
  if ($k === 'title' || substr($k, -6) === ':title') {
    // Prefer OG-specific value for OG/Twitter variants.
    if (strpos($k, 'og:') === 0 || strpos($k, 'twitter:') === 0) {
      return !empty($s['og_title']) ? $s['og_title'] : (isset($s['title']) ? $s['title'] : '');
    }
    return isset($s['title']) ? $s['title'] : '';
  }
  // Description-like (also cover abstract).
  if ($k === 'description' || $k === 'abstract' || substr($k, -12) === ':description') {
    if (strpos($k, 'og:') === 0 || strpos($k, 'twitter:') === 0) {
      return !empty($s['og_description']) ? $s['og_description'] : (isset($s['description']) ? $s['description'] : '');
    }
    return isset($s['description']) ? $s['description'] : '';
  }
  return '';
}

/**
 * Determine which metatag text fields are eligible for presave auto-fill.
 */
function ai_metatag_get_presave_text_tags($entity, $entity_type, $bundle, $langcode) {
  $enabled_text_tags = ai_metatag_get_enabled_text_tags();
  if (empty($enabled_text_tags)) {
    return [];
  }

  $candidate_tags = [
    'title' => TRUE,
    'description' => TRUE,
    'abstract' => TRUE,
    'keywords' => TRUE,
    'og:type' => TRUE,
  ];

  if (!empty($entity->metatags[$langcode]) && is_array($entity->metatags[$langcode])) {
    foreach (array_keys($entity->metatags[$langcode]) as $tag) {
      $candidate_tags[$tag] = TRUE;
    }
  }

  if (function_exists('metatag_get_entity_metatags_instance') && function_exists('metatag_config_load_with_defaults')) {
    $instance = metatag_get_entity_metatags_instance($entity, $entity_type, $bundle);
    $defaults = metatag_config_load_with_defaults($instance);
    if (is_array($defaults)) {
      foreach ($defaults as $tag => $data) {
        if (is_string($tag) && $tag !== '' && is_array($data)) {
          $candidate_tags[$tag] = TRUE;
        }
      }
    }
  }

  return array_intersect_key($enabled_text_tags, $candidate_tags);
}

/**
 * Normalize a description to fit within 140-160 characters.
 *
 * If too long, truncates at a word boundary staying >= 140. If too short,
 * extends using title and context. Returns the best available string; the
 * 140-char minimum is a guideline and is not enforced by padding.
 */
function ai_metatag_normalize_description($desc, $title = '', $context = '') {
  $min = 140;
  $max = 160;
  $desc = trim(strip_tags((string) $desc));
  $desc = preg_replace('/\s+/u', ' ', $desc);

  $len = mb_strlen($desc);
  if ($len >= $min && $len <= $max) {
    return $desc;
  }

  // If too long, truncate to max at a word boundary, but only accept the cut
  // if the result is still >= min to avoid an unexpectedly short string.
  if ($len > $max) {
    $tr = mb_substr($desc, 0, $max);
    $pos = mb_strrpos($tr, ' ');
    if ($pos !== FALSE && $pos >= $min) {
      $tr = mb_substr($tr, 0, $pos);
    }
    return rtrim($tr);
  }

  // Too short: try to extend using title and context.
  $add = '';
  if (!empty($title)) {
    $add .= ' ' . trim(strip_tags((string) $title));
  }
  if (!empty($context)) {
    $add .= ' ' . trim(strip_tags((string) $context));
  }
  $add = preg_replace('/\s+/u', ' ', trim($add));

  $candidate = trim($desc . ($desc !== '' && $add !== '' ? ' ' : '') . $add);

  // If still too short, append more words from context until we reach min.
  if (mb_strlen($candidate) < $min && $add !== '') {
    $words = preg_split('/\s+/u', $add, -1, PREG_SPLIT_NO_EMPTY);
    $cur = $desc;
    foreach ($words as $w) {
      if ($cur !== '') $cur .= ' ';
      $cur .= $w;
      if (mb_strlen($cur) >= $min) {
        break;
      }
    }
    $candidate = $cur;
  }

  // Final truncate to max if needed, trimming to last space while staying >= min.
  if (mb_strlen($candidate) > $max) {
    $tr = mb_substr($candidate, 0, $max);
    $pos = mb_strrpos($tr, ' ');
    if ($pos !== FALSE && $pos >= $min) {
      $tr = mb_substr($tr, 0, $pos);
    }
    $candidate = $tr;
  }

  return rtrim($candidate);
}
